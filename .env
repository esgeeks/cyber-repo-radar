# Public build-time settings (safe to commit — never put tokens here).
# Canonical URL of the site, without trailing slash. Override with the SITE_URL repository variable in Actions.
VITE_SITE_URL=https://radar.esgeeks.com
# AdSense (leave empty until approved). Example: ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_FEED=
# Cloudflare Web Analytics token (cookieless). Leave empty to disable.
VITE_CF_ANALYTICS_TOKEN=
