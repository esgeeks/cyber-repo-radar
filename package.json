  "version": "0.1.0",
  "description": "Discover recent public GitHub repositories related to cybersecurity.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
